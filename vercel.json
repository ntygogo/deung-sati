{
  "rewrites": [
    {
      "source": "/api/room/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/notebook/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/billing/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/beta/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/companion/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/loops/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/missions/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/user/:path*",
      "destination": "/api"
    },
    {
      "source": "/api/health",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
